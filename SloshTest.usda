#usda 1.0
(
    defaultPrim = "root"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "root"
{
    def Xform "Tank"
    {
        def Mesh "Tank"
        {
            uniform bool doubleSided = 0
            int[] faceVertexCounts = [3,3,3,3,3,3,3,3,3,3]
            int[] faceVertexIndices = [
                0,1,2, 0,2,3,
                0,3,7, 0,7,4,
                1,5,6, 1,6,2,
                0,4,5, 0,5,1,
                3,2,6, 3,6,7
            ]
            point3f[] points = [
                (-0.22,-0.20,0.00),
                ( 0.22,-0.20,0.00),
                ( 0.22, 0.20,0.00),
                (-0.22, 0.20,0.00),
                (-0.22,-0.20,0.24),
                ( 0.22,-0.20,0.24),
                ( 0.22, 0.20,0.24),
                (-0.22, 0.20,0.24)
            ]
            color3f[] primvars:displayColor = [(0.18,0.20,0.22)] (
                interpolation = "constant"
            )
        }
    }

    def Xform "FluidVolume"
    {
        def Mesh "FluidVolume"
        {
            int[] faceVertexCounts = [3,3,3,3,3,3,3,3,3,3,3,3]
            int[] faceVertexIndices = [
                0,1,2, 0,2,3,
                4,6,5, 4,7,6,
                0,4,5, 0,5,1,
                1,5,6, 1,6,2,
                2,6,7, 2,7,3,
                3,7,4, 3,4,0
            ]
            point3f[] points = [
                (-0.20,-0.18,0.00),
                ( 0.20,-0.18,0.00),
                ( 0.20, 0.18,0.00),
                (-0.20, 0.18,0.00),
                (-0.20,-0.18,0.10),
                ( 0.20,-0.18,0.10),
                ( 0.20, 0.18,0.10),
                (-0.20, 0.18,0.10)
            ]
            color3f[] primvars:displayColor = [(0.10,0.40,0.90)] (
                interpolation = "constant"
            )
            float[] primvars:displayOpacity = [0.20] (
                interpolation = "constant"
            )
        }
    }
}
